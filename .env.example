# OmniTrans 个人配置（复制为 .env 使用；.env 已被 .gitignore 排除，绝不入库）
# 留空全部 = 使用内置免费谷歌端点，无需任何密钥

# 接口类型：get = 机翻 GET 模板；openai = AI 翻译（OpenAI 兼容 chat/completions）
MT_API_TYPE=get

# 接口地址：
#   get    模式：URL 模板，{sl}=源语言 {tl}=目标语言 {q}=原文
#              例：https://api.example.com/translate?source={sl}&target={tl}&text={q}
#   openai 模式：完整 chat/completions 地址
#              例：https://api.deepseek.com/chat/completions
MT_ENDPOINT=

# AI 模式（openai）的模型名：deepseek-chat / gpt-4o-mini / glm-4-flash / moonshot-v1-8k ...
MT_MODEL=

# API 密钥（可选）。默认以 Authorization: Bearer <key> 发送；
# 你的服务用别的头就改 MT_API_HEADER，例如 X-Api-Key（此时以原值发送）
MT_API_KEY=
MT_API_HEADER=Authorization

# 命令行模式（mt_translate.py）的语言设置；GUI 模式以界面下拉框为准
MT_SL=en
MT_TL=zh-CN

# 敏感词被服务方拦截后，自动改用免费机翻端点兜底重译（1=开 默认 / 0=关）
MT_FALLBACK=1

# 界面主题：dark / light（GUI 顶栏 ☀/🌙 按钮切换，自动写入）
MT_THEME=dark

# 界面背景图（设置页选择；显示在「快速翻译」投放卡，需 Pillow）
# MT_BG=C:\path	o\image.png

# AI 批量翻译时附带前后各2句作上下文（提升人称/语气一致性；0=关闭省 token）
MT_CONTEXT=1

# 音视频听译模型（拖入无字幕视频时用）：tiny|base|small|medium|large-v3
# 默认 small；首次运行自动从 HuggingFace 下载并缓存（small ≈ 244MB）
# 国内下载慢可设系统环境变量 HF_ENDPOINT=https://hf-mirror.com
MT_ASR_MODEL=small

# 漫画嵌字用的字体文件路径（默认自动找系统 CJK 字体：微软雅黑/黑体/Noto 等）
# MT_FONT=C:\Windows\Fonts\msyh.ttc

# 漫画 OCR 识别模式：auto（默认，装了 manga-ocr 就用它识别日漫竖排）/ manga / rapid
# 日漫建议：pip install manga-ocr（含 torch 约 700MB，首次识别自动下载模型约 440MB）
MT_COMIC_OCR=auto
