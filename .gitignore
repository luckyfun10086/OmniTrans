names.txt
names.local.txt

# 工作目录（含原文/译文缓存，可能涉及未公开游戏文本）
mt_work/

# 测试产物（ManualTransFile 为 MTool 导出的游戏文本，勿上传）
ManualTransFile*.json
*_translated.json
missing_wordy.json

# Python
__pycache__/
*.pyc

# PyInstaller 构建产物（成品通过 GitHub Releases 发布，不入库）
build/
dist/
*.spec
AutoMT.exe
*.exe

# SRPG 桥接：第三方工具（首次运行自动下载）与解包工作区
bin/
srpg_work/

# 游戏提取产物（含游戏文本，绝不上传）
*_extracted*.json
*.extracted.json
unity_manifest.json
# 字幕/漫画 sidecar（含台词与文本框，同理绝不上传）
*_subs.json
*_comic.json

